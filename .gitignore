# macOS
.DS_Store
**/.DS_Store

# Rust build output
/target

# SQLite database and its write-ahead log — never commit real household data
*.db
*.db-wal
*.db-shm

# Rolling backups of the database
/backups

# Tailwind output. static/css/*.css is source; build.css is generated.
/static/css/build.css

# The operator's real config and env. ffm.example.toml IS committed.
/ffm.toml
.env

# The receipt vault, if anyone ever points receipts_root inside the repo.
# It holds real bills — it must never be committed by accident.
/receipts

# `just dev <date>`'s throwaway copy of the database and the vault — real
# bills, same as above.
/demo

# `just anon`'s shuffled copy. Made-up by design, but the run that wrote it
# read the real database, and an aborted run's leftovers may not be.
/anon
/anon.old-*

# `just release`'s output — binaries and tarballs, rebuilt from a tag.
/dist

# Issuer profiles are shipped as an example with placeholder CNPJs; a household
# replacing them with the real ones is editing its own copy, not the repo's.
# The example IS committed — see config/issuers.toml.
