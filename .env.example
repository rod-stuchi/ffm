# Copy to .env. Loaded by `just` (set dotenv-load) and by sqlx's compile-time
# query macros.

# sqlx::query! checks every query against a REAL schema at COMPILE time, so the
# database has to exist before `cargo build` does anything. `just db` creates it.
#
# Committed .sqlx/ is the way out of that for anyone who is not changing a
# query: SQLX_OFFLINE=true builds against it and needs no database at all, which
# is what CI does. Change a query and run `just prepare` to refresh it.
DATABASE_URL=sqlite://./ffm.db

# The operator tier, if you would rather set it here than in ffm.toml. These
# win over the file.
# FFM_DB_PATH=./ffm.db
# FFM_RECEIPTS_ROOT=./receipts
# FFM_BACKUP_DIR=./backups

# Bind address. `just dev-lan` overrides this to 0.0.0.0:3000.
# FFM_ADDR=127.0.0.1:3000

# "Today" is the process's local date — the due ring, overdue, the unresolved
# badge and the materializer all read it. One process serves one household in
# one place, so this is a deployment setting rather than a config key.
# TZ=America/Sao_Paulo
