#!/usr/bin/env bash
# Versioned hook — `just hooks` turns it on. Runs `just check-slow`;
# `git push --no-verify` skips it.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if command -v mise >/dev/null 2>&1; then
    run=(mise exec -- just check-slow)
else
    run=(just check-slow)
fi

if ! "${run[@]}"; then
    echo >&2
    echo "✗ pre-push: just check-slow failed — git push --no-verify skips this hook" >&2
    exit 1
fi
